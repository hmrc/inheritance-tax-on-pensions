# microservice specific routes

GET        /:pstr/submission-list         uk.gov.hmrc.inheritancetaxonpensions.controllers.GetSubmissionListController.getSubmissionList(pstr: String)
GET        /ihtp                          uk.gov.hmrc.inheritancetaxonpensions.controllers.GetReportController.getReport()

# User answers
PUT          /user-answers                uk.gov.hmrc.inheritancetaxonpensions.controllers.UserAnswersController.set()
GET          /user-answers/:id            uk.gov.hmrc.inheritancetaxonpensions.controllers.UserAnswersController.fetch(id: String)

# Report submission
POST         /:pstr/submit-report/:userAnswersId         uk.gov.hmrc.inheritancetaxonpensions.controllers.ReportSubmissionController.submitReport(pstr: String, userAnswersId: String)
