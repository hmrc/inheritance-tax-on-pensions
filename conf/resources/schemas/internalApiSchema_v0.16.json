{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "IHTP Report Submission",
  "type": "object",
  "required": [
    "reportDetails",
    "deceased",
    "personalRep",
    "ihTaxInformation",
    "declarations"
  ],
  "properties": {
    "reportDetails": {
      "$ref": "#/definitions/submitReportDetailsType"
    },
    "deceased": {
      "$ref": "#/definitions/deceasedType"
    },
    "personalRep": {
      "$ref": "#/definitions/prType"
    },
    "ihTaxInformation": {
      "$ref": "#/definitions/ihTaxInformationType"
    },
    "beneficiaries": {
      "$ref": "#/definitions/beneficiariesArrayType"
    },
    "declarations": {
      "$ref": "#/definitions/declarationsType"
    }
  },
  "definitions": {
    "SubmitIHTPPaymentNoticeResponse": {
      "type": "object",
      "required": [
        "FormBundleNo",
        "IHTPaymentReference"
      ],
      "properties": {
        "FormBundleNo": {
          "$ref": "#/definitions/formBundleNumType"
        },
        "IHTPaymentReference": {
          "$ref": "#/definitions/paymentReferenceType"
        }
      }
    },
    "submitReportDetailsType": {
      "type": "object",
      "required": [
        "pstr"
      ],
      "properties": {
        "pstr": {
          "type": "string",
          "pattern": "^([0-9]{8}[A-Z]{2})$",
          "description": "Pension Scheme Tax Reference",
          "example": "12345678AB"
        },
        "ihtPaymentReference": {
          "$ref": "#/definitions/paymentReferenceType"
        }
      }
    },
    "GetIHTPPaymentNoticeResponse": {
      "type": "object",
      "required": [
        "schemeDetails",
        "reportDetails",
        "deceased",
        "personalRep",
        "ihtTaxInformation",
        "declarations"
      ],
      "properties": {
        "schemeDetails": {
          "$ref": "#/definitions/schemeDetailsType"
        },
        "reportDetails": {
          "$ref": "#/definitions/getReportDetailsType"
        },
        "deceased": {
          "$ref": "#/definitions/deceasedType"
        },
        "personalRep": {
          "$ref": "#/definitions/prType"
        },
        "ihtTaxInformation": {
          "$ref": "#/definitions/ihTaxInformationType"
        },
        "beneficiaries": {
          "$ref": "#/definitions/beneficiariesArrayType"
        },
        "declarations": {
          "$ref": "#/definitions/declarationsType"
        }
      }
    },
    "schemeDetailsType": {
      "type": "object",
      "required": [
        "pstr",
        "schemeName",
        "schemeStartDate",
        "schemeEndDate"
      ],
      "properties": {
        "pstr": {
          "$ref": "#/definitions/pensionSchemeTaxRefType"
        },
        "schemeName": {
          "$ref": "#/definitions/pensionSchemeNameType"
        },
        "schemeStartDate": {
          "$ref": "#/definitions/dateYMDType"
        },
        "schemeEndDate": {
          "$ref": "#/definitions/dateYMDType"
        }
      }
    },
    "getReportDetailsType": {
      "type": "object",
      "required": [
        "submissionDate",
        "ihtVersion"
      ],
      "properties": {
        "submissionDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-10T16:12:49Z"
        },
        "ihtVersion": {
          "$ref": "#/definitions/versionNumberType"
        },
        "ihtPaymentReference": {
          "$ref": "#/definitions/paymentReferenceType"
        },
        "ihtPaid": {
          "$ref": "#/definitions/booleanTrueFalseType"
        },
        "ihtPaymentDate": {
          "$ref": "#/definitions/dateYMDType"
        }
      }
    },
    "GetIHTPPaymentNoticeOverviewResponse": {
      "type": "object",
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "type": "object",
          "required": [
            "ihtpOverview"
          ],
          "properties": {
            "ihtpOverview": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/paymentNoticeOverviewType"
              }
            }
          }
        }
      }
    },
    "paymentNoticeOverviewType": {
      "type": "object",
      "required": [
        "fbNumber",
        "submissionDate",
        "paymentDueDate",
        "ihtpVersion",
        "inheritanceTaxReference",
        "paymentReference",
        "firstForename",
        "surname",
        "ihtpStatus"
      ],
      "properties": {
        "fbNumber": {
          "$ref": "#/definitions/formBundleNumType"
        },
        "submissionDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-10T16:12:49Z"
        },
        "paymentDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-10T16:12:49Z"
        },
        "reconciledDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-10T16:12:49Z"
        },
        "paymentNoticeReceivedDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-04-10T16:12:49Z"
        },
        "ihtVersion": {
          "$ref": "#/definitions/versionNumberType"
        },
        "inheritanceTaxReference": {
          "$ref": "#/definitions/ihtRefNumberType"
        },
        "paymentReference": {
          "$ref": "#/definitions/paymentReferenceType"
        },
        "deceasedFirstForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "deceasedSurname": {
          "$ref": "#/definitions/NameFieldType"
        },
        "deceasedNino": {
          "$ref": "#/definitions/ninoType"
        },
        "ihtpStatus": {
          "$ref": "#/definitions/statusType"
        },
        "declarationSignatoryID": {
          "$ref": "#/definitions/submitterIDType"
        }
      }
    },
    "deceasedType": {
      "type": "object",
      "required": [
        "deceasedPersonalDetails",
        "deceasedDetails"
      ],
      "properties": {
        "deceasedChangeFlag": {
          "$ref": "#/definitions/changeFlagType"
        },
        "deceasedPersonalDetails": {
          "$ref": "#/definitions/deceasedPersonalDetailsType"
        },
        "deceasedDetails": {
          "$ref": "#/definitions/deceasedDetailsType"
        }
      }
    },
    "deceasedPersonalDetailsType": {
      "type": "object",
      "required": [
        "firstForename",
        "surname",
        "ninoExist"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "firstForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "surname": {
          "$ref": "#/definitions/NameFieldType"
        },
        "ninoExist": {
          "$ref": "#/definitions/booleanYesNoType"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "nino"
          ],
          "properties": {
            "nino": {
              "$ref": "#/definitions/ninoType"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reasonNoNINO"
          ],
          "properties": {
            "reasonNoNINO": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      ]
    },
    "deceasedDetailsType": {
      "type": "object",
      "required": [
        "deceasedsDOB",
        "deceasedsDOD",
        "ihtRefNumber"
      ],
      "properties": {
        "deceasedsDOB": {
          "$ref": "#/definitions/dateYMDType"
        },
        "deceasedsDOD": {
          "$ref": "#/definitions/dateYMDType"
        },
        "ihtRefNumber": {
          "$ref": "#/definitions/ihtRefNumberType"
        }
      }
    },
    "prType": {
      "type": "object",
      "required": [
        "typeOfPR",
        "prContactDetails",
        "prAddress"
      ],
      "properties": {
        "prChangeFlag": {
          "$ref": "#/definitions/changeFlagType"
        },
        "typeOfPR": {
          "$ref": "#/definitions/individualOrOrgType"
        },
        "prContactDetails": {
          "$ref": "#/definitions/prContactDetailsType"
        },
        "prAddress": {
          "$ref": "#/definitions/prAddressType"
        }
      }
    },
    "prContactDetailsType": {
      "type": "object",
      "required": [
        "firstForename",
        "surname"
      ],
      "properties": {
        "orgName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "firstForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "secondForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "surname": {
          "$ref": "#/definitions/NameFieldType"
        }
      }
    },
    "prAddressType": {
      "type": "object",
      "required": [
        "addressLine1",
        "addressLine2",
        "country"
      ],
      "properties": {
        "addressLine1": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine2": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine3": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine4": {
          "$ref": "#/definitions/AddressLineType"
        },
        "postcode": {
          "$ref": "#/definitions/UKPostcodeType"
        },
        "country": {
          "$ref": "#/definitions/countryCodeType"
        }
      }
    },
    "ihTaxInformationType": {
      "type": "object",
      "required": [
        "dateNoticeReceived",
        "noticeSubmittedByPR"
      ],
      "properties": {
        "ihTaxChangeFlag": {
          "$ref": "#/definitions/changeFlagType"
        },
        "dateNoticeRecieved": {
          "type": "string",
          "format": "date'"
        },
        "noticeSubmittedByPR": {
          "$ref": "#/definitions/booleanYesNoType"
        },
        "knownBeneficiaries": {
          "$ref": "#/definitions/booleanYesNoType"
        },
        "totalIHTPayable": {
          "$ref": "#/definitions/currencyType"
        },
        "totalInterestPayable": {
          "$ref": "#/definitions/currencyType"
        },
        "total": {
          "$ref": "#/definitions/currencyType"
        }
      }
    },
    "beneficiariesArrayType": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/beneficiaryInstanceType"
      }
    },
    "beneficiaryInstanceType": {
      "type": "object",
      "required": [
        "beneficiaryType",
        "beneficiaryContactDetails",
        "beneficiaryPaymentDetails"
      ],
      "properties": {
        "beneficiaryChangeFlag": {
          "$ref": "#/definitions/changeFlagType"
        },
        "beneficiaryType": {
          "$ref": "#/definitions/individualOrTrustType"
        },
        "beneficiaryContactDetails": {
          "$ref": "#/definitions/beneficiaryContactDetailsType"
        },
        "beneficiaryPaymentDetails": {
          "$ref": "#/definitions/beneficiaryPaymentDetailsType"
        }
      }
    },
    "beneficiaryContactDetailsType": {
      "type": "object",
      "required": [
        "beneficiaryPersonalDetails",
        "beneficiaryAddress"
      ],
      "properties": {
        "beneficiaryTrstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "beneficiaryPersonalDetails": {
          "$ref": "#/definitions/beneficiaryPersonalDetailsType"
        },
        "beneficiaryAddress": {
          "$ref": "#/definitions/beneficiaryAddressType"
        }
      }
    },
    "beneficiaryPersonalDetailsType": {
      "type": "object",
      "required": [
        "firstForename",
        "surname",
        "ninoExist"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "firstForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "secondForename": {
          "$ref": "#/definitions/NameFieldType"
        },
        "surname": {
          "$ref": "#/definitions/NameFieldType"
        },
        "ninoExist": {
          "$ref": "#/definitions/booleanYesNoType"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "nino"
          ],
          "properties": {
            "nino": {
              "$ref": "#/definitions/ninoType"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reasonNoNINO"
          ],
          "properties": {
            "reasonNoNINO": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      ]
    },
    "beneficiaryAddressType": {
      "type": "object",
      "required": [
        "addressLine1",
        "addressLine2",
        "country"
      ],
      "properties": {
        "addressLine1": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine2": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine3": {
          "$ref": "#/definitions/AddressLineType"
        },
        "addressLine4": {
          "$ref": "#/definitions/AddressLineType"
        },
        "postcode": {
          "$ref": "#/definitions/UKPostcodeType"
        },
        "country": {
          "$ref": "#/definitions/countryCodeType"
        }
      }
    },
    "beneficiaryPaymentDetailsType": {
      "type": "object",
      "required": [
        "beneficiaryIHTPayable",
        "beneficiaryInterestPayable",
        "beneficiaryTotal"
      ],
      "properties": {
        "beneficiaryIHTPayable": {
          "$ref": "#/definitions/currencyType"
        },
        "beneficiaryInterestPayable": {
          "$ref": "#/definitions/currencyType"
        },
        "beneficiaryTotal": {
          "$ref": "#/definitions/currencyType"
        }
      }
    },
    "declarationsType": {
      "type": "object",
      "required": [
        "submittedBy",
        "submitterID"
      ],
      "properties": {
        "submittedBy": {
          "$ref": "#/definitions/submitterType"
        },
        "submitterID": {
          "$ref": "#/definitions/submitterIDType"
        },
        "submitterName": {
          "$ref": "#/definitions/NameFieldType"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "psaDeclaration"
          ],
          "properties": {
            "psaDeclaration": {
              "$ref": "#/definitions/PSADeclarationType"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pspDeclaration"
          ],
          "properties": {
            "pspDeclaration": {
              "$ref": "#/definitions/PSPDeclarationType"
            }
          }
        }
      ]
    },
    "PSADeclarationType": {
      "type": "object",
      "required": [
        "psaDeclaration1",
        "psaDeclaration2"
      ],
      "properties": {
        "psaDeclaration1": {
          "$ref": "#/definitions/booleanTrueFalseType"
        },
        "psaDeclaration2": {
          "$ref": "#/definitions/booleanTrueFalseType"
        }
      }
    },
    "PSPDeclarationType": {
      "type": "object",
      "required": [
        "pspDeclaration1",
        "pspDeclaration2",
        "psaid"
      ],
      "properties": {
        "pspDeclaration1": {
          "$ref": "#/definitions/booleanTrueFalseType"
        },
        "pspDeclaration2": {
          "$ref": "#/definitions/booleanTrueFalseType"
        },
        "psaid": {
          "$ref": "#/definitions/submitterIDType"
        },
        "schemeAdministrator": {
          "$ref": "#/definitions/NameFieldType"
        }
      }
    },
    "booleanYesNoType": {
      "enum": [
        "No",
        "Yes"
      ],
      "type": "string"
    },
    "booleanTrueFalseType": {
      "enum": [
        "true",
        "false"
      ],
      "type": "string"
    },
    "changeFlagType": {
      "type": "string",
      "enum": [
        "Yes"
      ],
      "description": "Has this section been updated?"
    },
    "dateYMDType": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD Date Format"
    },
    "ninoType": {
      "type": "string",
      "pattern": "^(?!BG|GB|KN|NK|NT|TN|ZZ)[ABCEGHJKLMNOPRSTWXYZ][ABCEGHJKLMNPRSTWXYZ][0-9]{6}[ABCD]$",
      "description": "General NINO format.  Note: this is not the complete format specification"
    },
    "ihtRefNumberType": {
      "type": "string",
      "pattern": "^[AF][0-9]{6}/[0-9]{2}[A-Z]$",
      "description": "IHT Reference Number e.g. A123456/25A or F123456/25B"
    },
    "paymentReferenceType": {
      "type": "string",
      "pattern": "^([A,F]{1}[0-9]{6}/[0-9]{2}[A-Z]{1}[0-9]{3}[0-9,A-Z]{3})$",
      "description": "Payment reference = IHTReference + 6 digit ID",
      "example": "A123456/56A1238RC"
    },
    "statusType": {
      "type": "string",
      "description": "IHTP Submission status, e.g. draft, submitted, paid",
      "example": "Submitted"
    },
    "currencyType": {
      "description": "decimal between 0.00 and 999,999,999.99",
      "multipleOf": 0.01,
      "maximum": 999999999.99,
      "minimum": -99999999.99,
      "type": "number"
    },
    "individualOrOrgType": {
      "description": "Is this an individual or organisation ? 01 - Individual, 02 - Organisation",
      "enum": [
        "01",
        "02"
      ],
      "type": "string"
    },
    "individualOrTrustType": {
      "description": "Is this an individual or trust ? 01 - Individual, 02 - Trust",
      "enum": [
        "01",
        "02"
      ],
      "type": "string"
    },
    "submitterType": {
      "enum": [
        "PSA",
        "PSP"
      ],
      "type": "string",
      "description": "User type, either PSA or PSP"
    },
    "submitterIDType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "PSA ID or PSP ID"
    },
    "AddressLineType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "description": "Address line"
    },
    "NameFieldType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "description": "First Forename, Second Forename or Surname field"
    },
    "UKPostcodeType": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,4} [A-Z0-9]{3}$",
      "description": "UK Postcode format, does not match international postcodes"
    },
