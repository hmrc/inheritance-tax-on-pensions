    "currencyType": {
      "description": "decimal between 0.00 and 999,999,999.99",
      "type": "number",
      "minimum": -999999999.99,
      "maximum": 999999999.99,
      "multipleOf": 0.01
    },
    "deceased": {
      "type": "object",
      "properties": {
        "deceasedChangeFlag": {
          "description": "Has this section been updated?",
          "$ref": "#/definitions/booleanType"
        },
        "deceasedPersonalDetails": {
          "$ref": "#/definitions/personType"
        },
        "deceasedDetails": {
          "$ref": "#/definitions/deceasedDetails"
        }
      },
      "required": [
        "deceasedPersonalDetails",
        "deceasedDetails"
      ],
      "additionalProperties": false
    },
    "deceasedDetails": {
      "type": "object",
      "properties": {
        "deceasedsDob": {
          "description": "Deceased's Date of Birth",
          "type": "string",
          "maxLength": 10,
          "format": "date"
        },
        "deceasedsDod": {
          "description": "Deceased's Date of Death",
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "ihtRefNumber": {
          "description": "IHT Reference Number",
          "type": "string",
          "minLength": 1,
          "maxLength": 11
        }
      },
      "required": [
        "deceasedsDob",
        "deceasedsDod",
        "ihtRefNumber"
      ]
    },
    "declarations": {
      "description": "Only populated when the PR has completed the notice",
      "type": "object",
      "properties": {
        "submittedBy": {
          "description": "Submitted By",
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "submitterId": {
          "description": "Submitter ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "psaDeclaration": {
          "$ref": "#/definitions/psaDeclaration"
        },
        "pspDeclaration": {
          "$ref": "#/definitions/pspDeclaration"
        }
      },
      "required": [
        "submittedBy",
        "submitterId"
      ],
      "additionalProperties": false
    },
    "declarationsGet": {
      "description": "Only populated when the PR has completed the notice",
      "type": "object",
      "properties": {
        "submittedBy": {
          "description": "Submitted By",
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "submitterId": {
          "description": "Submitter ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "submitterName": {
          "$ref": "#/definitions/string35Type"
        },
        "psaDeclaration": {
          "$ref": "#/definitions/psaDeclarationGet"
        },
        "pspDeclaration": {
          "$ref": "#/definitions/pspDeclarationGet"
        }
      },
      "required": [
        "submittedBy",
        "submitterId"
      ],
      "additionalProperties": false
    },
    "errors_type": {
      "type": "object",
      "properties": {
        "processingDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-([0][1-9]|[1][0-2])-([0][1-9]|[1-2][0-9]|[3][0-1])T([0-1][0-9]|[2][0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "code": {
          "type": "string",
          "enum": [
            "003",
            "049",
            "055",
            "080",
            "081",
            "082",
            "999"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "processingDate",
        "code",
        "text"
      ],
      "additionalProperties": false
    },
    "ihTaxInformation": {
      "type": "object",
      "properties": {
        "ihTaxChangeFlag": {
          "description": "Has this section been updated?",
          "$ref": "#/definitions/booleanType"
        },
        "dateNoticeReceived": {
          "description": "Date the Pension Scheme received notice to pay",
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "noticeSubmittedByPr": {
          "description": "Did the Personal Representative submit the notice? ",
          "$ref": "#/definitions/booleanType"
        },
        "knownBeneficiaries": {
          "description": "Are the beneficiaries known? ",
          "$ref": "#/definitions/booleanType"
        },
        "totalIhtPayable": {
          "description": "Total amount of IHT payable in the notice",
          "$ref": "#/definitions/currencyType"
        },
        "totalInterestPayable": {
          "description": "Total amount of interest payable in the notice ",
          "$ref": "#/definitions/currencyType"
        },
        "total": {
          "description": "Total",
          "$ref": "#/definitions/currencyType"
        }
      },
      "required": [
        "dateNoticeReceived",
        "noticeSubmittedByPr"
      ],
      "additionalProperties": false
    },
    "ninoType": {
      "type": "string",
      "pattern": "^([A-Z]{2}[0-9]{6}[A-Z]{1})$"
    },
    "personType": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "firstForename": {
          "$ref": "#/definitions/string35Type"
        },
        "secondForename": {
          "$ref": "#/definitions/string35Type"
        },
        "surname": {
          "$ref": "#/definitions/string35Type"
        },
        "ninoExist": {
          "description": "Do they have a National Insurance number?",
          "type": "string",
          "minLength": 2,
          "maxLength": 3
        },
        "nino": {
          "description": "NINO",
          "$ref": "#/definitions/ninoType"
        },
        "reasonNoNINO": {
          "$ref": "#/definitions/string160Type"
        }
      },
      "required": [
        "firstForename",
        "surname"
      ],
      "additionalProperties": false
    },
    "podsIHTPCreateEtmpErrorsType": {
      "type": "object",
      "properties": {
        "errors": {
          "description": "ETMP Business Validation Error Response",
          "type": "object",
          "properties": {
            "processingDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-([0][1-9]|[1][0-2])-([0][1-9]|[1-2][0-9]|[3][0-1])T([0-1][0-9]|[2][0-3]):[0-5][0-9]:[0-5][0-9]Z$"
            },
            "code": {
              "type": "string",
              "enum": [
                "001",
                "003",
                "004",
                "046",
                "058",
                "090",
                "091",
                "092",
                "093",
                "171",
                "080",
                "083",
                "999"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "processingDate",
            "code",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "errors"
      ],
      "additionalProperties": false
    },
    "podsIHTPCreateRequestSchema": {
      "description": "IHT Payment Notice Request",
      "type": "object",
      "properties": {
        "ihtNoticeRequest": {
          "type": "object",
          "properties": {
            "reportDetails": {
              "$ref": "#/definitions/reportDetails"
            },
            "deceased": {
              "$ref": "#/definitions/deceased"
            },
            "personalRep": {
              "$ref": "#/definitions/pr"
            },
            "ihTaxInformation": {
              "$ref": "#/definitions/ihTaxInformation"
            },
            "beneficiary": {
              "$ref": "#/definitions/beneficiary"
            },
            "declarations": {
              "$ref": "#/definitions/declarations"
            }
          },
          "required": [
            "reportDetails",
            "deceased",
            "personalRep",
            "ihTaxInformation",
            "declarations"
          ]
        }
      },
      "required": [
        "ihtNoticeRequest"
      ],
      "additionalProperties": false
    },
    "podsIHTPCreateResponseSchemaSuccess": {
      "description": "Comment describing your JSON Schema",
      "properties": {
        "success": {
          "type": "object",
          "properties": {
            "ihtResponse": {
              "type": "object",
              "properties": {
                "formBundleNo": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 15
                },
                "ihtPaymentReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 17
                }
              },
              "required": [
                "formBundleNo",
                "ihtPaymentReference"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podsIHTPGetEtmpErrorsType": {
      "type": "object",
      "properties": {
        "errors": {
          "$ref": "#/definitions/errors_type"
        }
      },
      "required": [
        "errors"
      ]
    },
    "podsIHTPGetResponseSchemaSuccess": {
      "description": "IHT Payment Notice Response",
      "type": "object",
      "properties": {
        "ihtNoticeResponse": {
          "type": "object",
          "properties": {
            "schemeDetails": {
              "$ref": "#/definitions/schemeDetailsGet"
            },
            "reportDetails": {
              "$ref": "#/definitions/reportDetailsGet"
            },
            "deceased": {
              "$ref": "#/definitions/deceased"
            },
            "personalRep": {
              "$ref": "#/definitions/pr"
            },
            "ihTaxInformation": {
              "$ref": "#/definitions/ihTaxInformation"
            },
            "beneficiary": {
              "$ref": "#/definitions/beneficiary"
            },
            "declarations": {
              "$ref": "#/definitions/declarationsGet"
            }
          },
          "required": [
            "schemeDetails",
            "reportDetails",
            "deceased",
            "personalRep",
            "ihTaxInformation",
            "declarations"
          ]
        }
      },
      "required": [
        "ihtNoticeResponse"
      ],
      "additionalProperties": false
    },
    "pr": {
      "type": "object",
      "properties": {
        "prChangeFlag": {
          "description": "Has this section been updated?",
          "$ref": "#/definitions/booleanType"
        },
        "typeOfPr": {
          "description": "Is the Personal Representative an Individual(01) or Organisation(02)? ",
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "enum": [
            "01",
            "02"
          ]
        },
        "prContactDetails": {
          "$ref": "#/definitions/prContactDetails"
        },
        "prAddress": {
          "$ref": "#/definitions/addressType"
        }
      },
      "required": [
        "typeOfPr",
        "prContactDetails",
        "prAddress"
      ],
      "additionalProperties": false
    },
    "prContactDetails": {
      "type": "object",
      "properties": {
        "orgName": {
          "$ref": "#/definitions/string160Type"
        },
        "title": {
          "description": "Title",
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "firstForename": {
          "$ref": "#/definitions/string35Type"
        },
        "secondForename": {
          "$ref": "#/definitions/string35Type"
        },
        "surname": {
          "$ref": "#/definitions/string35Type"
        }
      },
      "required": [
        "firstForename",
        "surname"
      ]
    },
    "psaDeclaration": {
      "type": "object",
      "properties": {
        "psaDeclaration1": {
          "description": "I've received and checked the information in the notice. ",
          "type": "boolean"
        },
        "psaDeclaration2": {
          "description": "I declare that to the best of my knowledge and belief the information given in this notification is correct and complete",
          "type": "boolean"
        }
      }
    },
    "psaDeclarationGet": {
      "type": "object",
      "properties": {
        "psaDeclaration1": {
          "description": "I've received and checked the information in the notice. ",
          "type": "boolean"
        },
        "psaDeclaration2": {
          "description": "I declare that to the best of my knowledge and belief the information given in this notification is correct and complete",
          "type": "boolean"
        }
      }
    },
    "pspDeclaration": {
      "type": "object",
      "properties": {
        "pspDeclaration1": {
          "description": "I've received and checked the information in the notice on behalf of the Scheme Administrator. ",
          "type": "boolean"
        },
        "pspDeclaration2": {
          "description": "I declare that to the best of my knowledge and belief the information given in this notification is correct and complete and that the content of this report has been approved by the scheme administrator named below has authorised me to submit this report",
          "type": "boolean"
        },
        "psaid": {
          "description": "Scheme administrator ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        }
      }
    },
    "pspDeclarationGet": {
      "type": "object",
      "properties": {
        "pspDeclaration1": {
          "description": "I've received and checked the information in the notice on behalf of the Scheme Administrator. ",
          "type": "boolean"
        },
        "pspDeclaration2": {
          "description": "I declare that to the best of my knowledge and belief the information given in this notification is correct and complete and that the content of this report has been approved by the scheme administrator named below has authorised me to submit this report",
          "type": "boolean"
        },
        "psaid": {
          "description": "Scheme administrator ID",
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "schemeAdministrator": {
          "$ref": "#/definitions/string35Type"
        }
      }
    },
    "reportDetails": {
      "type": "object",
      "properties": {
        "pstr": {
          "description": "PSTR",
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]{8}[A-Z]{2}$"
        },
        "ihtPaymentReference": {
          "description": "IHT Payment Reference",
          "type": "string",
          "minLength": 1,
          "maxLength": 17
        }
      },
      "required": [
        "pstr"
      ],
      "additionalProperties": false
    },
    "reportDetailsGet": {
      "type": "object",
      "properties": {
        "submissionDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "ihtVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "ihtPaymentReference": {
          "description": "IHT Payment Reference",
          "type": "string",
          "minLength": 1,
          "maxLength": 17
        },
        "ihtPaid": {
          "type": "boolean"
        },
        "ihtPaymentDate": {
          "type": "string",
          "maxLength": 10,
          "format": "date"
        }
      },
      "required": [
        "submissionDate",
        "ihtVersion"
      ],
      "additionalProperties": false
    },
    "schemeDetailsGet": {
      "type": "object",
      "properties": {
        "pstr": {
          "description": "PSTR",
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]{8}[A-Z]{2}$"
        },
        "schemeName": {
          "$ref": "#/definitions/string160Type"
        },
        "schemeStartDate": {
