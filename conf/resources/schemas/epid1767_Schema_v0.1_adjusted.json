{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "IHT Payment Notice Request",
  "type": "object",
  "properties": {
    "ihtNoticeRequest": {
      "type": "object",
      "properties": {
        "reportDetails": {
          "$ref": "#/definitions/reportDetails"
        },
        "deceased": {
          "$ref": "#/definitions/deceased"
        },
        "personalRep": {
          "$ref": "#/definitions/pr"
        },
        "ihTaxInformation": {
          "$ref": "#/definitions/ihTaxInformation"
        },
        "beneficiary": {
          "$ref": "#/definitions/beneficiary"
        },
        "declarations": {
          "$ref": "#/definitions/declarations"
        }
      },
      "required": [
        "reportDetails",
        "deceased",
        "personalRep",
        "ihTaxInformation",
        "declarations"
      ]
    }
  },
  "required": [
    "ihtNoticeRequest"
  ],
  "additionalProperties": false,
  "definitions": {
    "addressType": {
      "type": "object",
      "properties": {
        "addressline1": {
          "$ref": "#/definitions/string35Type"
        },
        "addressline2": {
          "$ref": "#/definitions/string35Type"
        },
        "addressline3": {
          "$ref": "#/definitions/string35Type"
        },
        "addressline4": {
          "$ref": "#/definitions/string35Type"
        },
        "addressline5": {
          "$ref": "#/definitions/string35Type"
        },
        "postcode": {
          "description": "UK Postcode",
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "country": {
          "description": "2-Character ISO Country Code",
          "$ref": "#/definitions/countryCodeType"
        }
      },
      "required": [
        "addressline1"
      ],
      "additionalProperties": false
    },
    "beneficiary": {
      "type": "array",
      "items": {
        "properties": {
          "beneficiaryChangeFlag": {
            "description": "Has this section been updated?",
            "type": "string",
            "minLength": 1,
            "maxLength": 3
          },
          "beneficiaryType": {
            "description": "Is the beneficiary an Individual(01) or Trust(02)?",
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "enum": [
              "01",
              "02"
            ]
          },
          "beneficiaryContactDetails": {
            "$ref": "#/definitions/beneficiaryContactDetails"
          },
          "beneficiaryPaymentDetails": {
            "$ref": "#/definitions/beneficiaryPaymentDetails"
          }
        },
        "required": [
          "beneficiaryPaymentDetails"
        ]
      }
    },
    "beneficiaryContactDetails": {
      "type": "object",
      "properties": {
        "beneficiaryTrustName": {
          "$ref": "#/definitions/string160Type"
        },
        "beneficiaryPersonalDetails": {
          "$ref": "#/definitions/personType"
        },
        "beneficiaryAddress": {
          "$ref": "#/definitions/addressType"
        }
      },
      "required": [
        "beneficiaryPersonalDetails"
      ]
    },
    "beneficiaryPaymentDetails": {
      "type": "object",
      "properties": {
        "beneficiaryIhtPayable": {
          "description": "Amount of IHT payable in the notice for this beneficiary",
          "$ref": "#/definitions/currencyType"
        },
        "beneficiaryInterestPayable": {
          "description": "Interest payable in the notice for this beneficiary ",
          "$ref": "#/definitions/currencyType"
        },
        "beneficiaryTotal": {
          "description": "Total for this beneficiary ",
          "$ref": "#/definitions/currencyType"
        }
      },
      "required": [
        "beneficiaryIhtPayable",
        "beneficiaryInterestPayable",
        "beneficiaryTotal"
      ]
    },
    "booleanType": {
      "type": "string",
      "enum": [
        "No",
        "Yes"
      ]
    },
