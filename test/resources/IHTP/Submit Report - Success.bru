meta {
  name: Submit Report - Success
  type: http
  seq: 11
}

post {
  url: {{ihtp_url}}/{{pstr}}/submit-report/{{user_answers_id}}
  body: none
  auth: bearer
}

headers {
  srn: {{srn}}
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSA
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });

  test("Response contains the submission identifiers", function () {
      expect(res.body.formBundleNumber).to.be.a("string").and.not.be.empty;
      expect(res.body.paymentReference).to.be.a("string").and.not.be.empty;
      expect(res.body.processingDateTime).to.be.a("string").and.not.be.empty;
  });
}
