meta {
  name: Retrieve Report - Bad Request 400
  type: http
  seq: 8
}

get {
  url: {{ihtp_url}}/ihtp?pstr=24000001IN&fbNumber=119000004320&paymentReferenceNumber=A123456/25A-629671
  body: none
  auth: bearer
}

params:query {
  pstr: 24000001IN
  fbNumber: 119000004320
  paymentReferenceNumber: A123456/25A-629671
}

headers {
  srn: S0000000042
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSA
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 400", function () {
      expect(res.getStatus()).to.equal(400);
  });

  test("Response contains the HoD error", function () {
      expect(res.body.origin).to.equal("HoD");
      expect(res.body.response.error.code).to.equal("400");
  });
}
