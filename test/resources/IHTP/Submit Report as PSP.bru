meta {
  name: Submit Report as PSP
  type: http
  seq: 17
}

post {
  url: {{ihtp_url}}/{{pstr}}/submit-report/{{user_answers_id}}
  body: none
  auth: bearer
}

headers {
  srn: {{srn}}
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSP
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains the submission identifiers", function () {
      expect(res.body.formBundleNo).to.be.a("string").and.not.be.empty;
      expect(res.body.ihtPaymentReference).to.be.a("string").and.not.be.empty;
  });
}
