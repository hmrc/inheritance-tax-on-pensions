meta {
  name: Submit Report with schema validation errors
  type: http
  seq: 19
}

post {
  url: {{ihtp_url}}/{{pstr}}/submit-report/{{user_answers_id}}
  body: none
  auth: bearer
}

headers {
  srn: {{srn}}
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSP
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response contains validationErrors", function () {
      expect(res.body.message).to.be.a("string").and.not.be.empty;
      expect(res.body.message).contains("validationErrors");
  });
}
