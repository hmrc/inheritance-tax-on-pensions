meta {
  name: Retrieve Report - No Records 422
  type: http
  seq: 7
}

get {
  url: {{ihtp_url}}/ihtp?pstr=24000001IN&fbNumber=999999999999
  body: none
  auth: bearer
}

params:query {
  pstr: 24000001IN
  fbNumber: 999999999999
}

headers {
  srn: S0000000042
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSA
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 422", function () {
      expect(res.getStatus()).to.equal(422);
  });

  test("Response contains the ETMP validation error", function () {
      expect(res.body.errors.code).to.equal("003");
      expect(res.body.errors.text).to.equal("Request could not be processed");
  });
}
