meta {
  name: Retrieve Report - No Records 422
  type: http
  seq: 11
}

get {
  url: {{ihtp_url}}/ihtp?pstr=24000001IN&fbNumber=999999999999
  body: none
  auth: bearer
}

params:query {
  pstr: 24000001IN
  fbNumber: 999999999999
}

headers {
  srn: S0000000042
  userName: TestUser
  schemeName: TestScheme
  requestRole: PSA
}

auth:bearer {
  token: {{bearer_token}}
}

tests {
  test("Status code is 422", function () {
      expect(res.getStatus()).to.equal(422);
  });

  test("Response contains the backend error message", function () {
      expect(res.body.message).to.equal("The request was received but could not be processed");
  });
}
